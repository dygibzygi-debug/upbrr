# Operator-local paths for scripts/zulea/deploy/v5/zulea-upbrr.sh.
# Copy to zulea-upbrr.env next to the wrapper and fill from the wrapper that
# is running today. Do not commit the filled file. This example is checksummed;
# the filled file is not.
#
# ZULEA_IMAGE is the new image. Leave zulea-upbrr:5b87372 on the host.

ZULEA_IMAGE=zulea-upbrr:0.6.0
ZULEA_LIBRARY=
ZULEA_LIBRARY_MOUNT=
ZULEA_FREEZE=
ZULEA_TITLES=
ZULEA_TM_RUNS=
ZULEA_TM_OUTPUT=
ZULEA_WORK=
ZULEA_SECRETS=
